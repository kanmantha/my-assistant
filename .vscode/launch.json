{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MyAssistant.API (backend)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/backend/MyAssistant.API/bin/Debug/net8.0/MyAssistant.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/MyAssistant.API",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ]
}
