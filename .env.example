# Copy to .env and adjust values before running.

# SQLite connection string used by the API. Relative paths are resolved
# against the API working directory; use an absolute path when running in
# Docker (see docker-compose.yml).
DATABASE_CONNECTION_STRING=Data Source=myassistant.db

# JWT signing secret - generate a long random string (e.g. openssl rand -hex 64).
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# AI provider: "local" (offline heuristic parser) or "openai".
AI_PROVIDER=local
# Only required when AI_PROVIDER=openai.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# CORS origins allowed to call the API (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
