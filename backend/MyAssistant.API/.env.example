# === My Assistant backend environment (copy to .env) ===

# Database
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=myassistant;Username=postgres;Password=postgres

# Auth (REQUIRED in production - keep secret)
JWT_SECRET=generate-a-long-random-string-min-32-chars

# Provider selection: mock | openai | azureopenai | gemini
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Provider selection: mock | google
SPEECH_PROVIDER=mock
SPEECH_API_KEY=
TTS_API_KEY=

# Provider selection: mock | googleplay | apple
PAYMENT_PROVIDER=mock

# CORS origins separated by ; (use specific origins in production)
CORS_ORIGINS=*

# Admin bootstrap (used by Seeder only when the user does not exist yet)
ADMIN_USERNAME=admin@myassistant.in
ADMIN_PASSWORD=Admin123!