{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=myassistant.db"
  },
  "Jwt": {
    "Secret": "CHANGE_ME__generate_a_long_random_secret_key_for_production",
    "Issuer": "MyAssistant",
    "Audience": "MyAssistantClient",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "AI": {
    "Provider": "local",
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "BaseUrl": "https://api.openai.com/v1"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Email": {
    "From": "no-reply@myassistant.app",
    "FrontendUrl": "http://localhost:5173"
  },
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "GlobalWindowMinutes": 1
  }
}
